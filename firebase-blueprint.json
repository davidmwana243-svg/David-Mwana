{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Information about the registered user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "profilePhoto": { "type": "string" },
        "wishlist": { "type": "array" },
        "addresses": { "type": "array" },
        "createdAt": { "type": "number" },
        "preferredPaymentMethod": { "type": "string" },
        "paymentPhone": { "type": "string" },
        "notificationsEnabled": { "type": "boolean" }
      },
      "required": ["id", "email", "displayName"]
    },
    "Product": {
      "title": "Product",
      "description": "Store product items.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "imageUrl": { "type": "string" },
        "images": { "type": "array" },
        "category": { "type": "string" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "averageRating": { "type": "number" },
        "totalReviews": { "type": "number" },
        "stock": { "type": "number" },
        "salesCount": { "type": "number" },
        "createdAt": { "type": "number" }
      }
    },
    "Review": {
      "title": "Review",
      "description": "Product reviews.",
      "type": "object",
      "properties": {
        "reviewId": { "type": "string" },
        "productId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["reviewId", "productId", "rating", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "telegramId": { "type": "string" },
        "type": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" },
        "sentAt": { "type": "number" }
      },
      "required": ["id", "userId", "telegramId", "type", "message", "status", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" },
        "shippingAddress": { "type": "object" },
        "paymentMethod": { "type": "string" },
        "paymentPhone": { "type": "string" },
        "qrToken": { "type": "string" }
      }
    },
    "Category": {
      "title": "Category",
      "description": "Product categories.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "icon": { "type": "string" },
        "imageUrl": { "type": "string" }
      }
    },
    "FcmToken": {
      "title": "FCM Token",
      "description": "FCM token for push notifications.",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "userId": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["token", "userId", "updatedAt"]
    },
    "Cart": {
      "title": "Cart",
      "description": "User shopping cart.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["userId", "items", "updatedAt"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Product catalog."
    },
    "reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product reviews."
    },
    "categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories."
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders."
    },
    "fcm_tokens/{tokenId}": {
      "schema": "FcmToken",
      "description": "FCM registration tokens mapping."
    },
    "carts/{cartId}": {
      "schema": "Cart",
      "description": "User shopping carts."
    },
    "notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications."
    }
  }
}
